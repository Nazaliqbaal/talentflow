# Copy this file to .env and fill in the values.
# Never commit .env to Git.

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5143

# ── Backend ───────────────────────────────────────────────────────────────────
# ASP.NET environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Development

# Database connection string (when you add a real DB later)
# DB_CONNECTION_STRING=Server=localhost;Database=talentflow;User=sa;Password=

# JWT secret for auth (when you add authentication later)
# JWT_SECRET=
